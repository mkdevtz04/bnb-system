APP_NAME=CoastalCharmz
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bnb_system
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Where guest replies land. Defaults to MAIL_FROM_ADDRESS.
MAIL_REPLY_TO_ADDRESS=
MAIL_FROM_ADDRESS="bookings@coastalcharmz.com"
MAIL_FROM_NAME="CoastalCharmz"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Booking engine — see config/booking.php
BOOKING_CURRENCY=USD
BOOKING_SERVICE_FEE_RATE=0.05
BOOKING_TAX_RATE=0.10
BOOKING_MAX_NIGHTS=30
BOOKING_WINDOW_MONTHS=12

# Google sign-in via Firebase Authentication.
# All three are public identifiers, not secrets: Firebase console -> Project
# settings -> Your apps -> Web app. Verification uses Google public certificates,
# so no service account key is needed.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_GOOGLE_CLIENT_ID=
FIREBASE_AUTH_DOMAIN=
